      "source": [
        "\n",
        "import numpy as np\n",
        "\n",
        "rng = np.random.default_rng(0)\n",
        "\n",
        "# Gold rewards of 200 candidate answers\n",
        "gold = rng.normal(size=200)\n",
        "\n",
        "def annotate(n_pairs, noise):\n",
        "    \"\"\"Simulate annotator preferences with noise.\"\"\"\n",
        "    i, j = rng.integers(0, len(gold), (2, n_pairs))\n",
        "\n",
        "    # Remove pairs containing the same answer\n",
        "    keep = i != j\n",
        "    i, j = i[keep], j[keep]\n",
        "\n",
        "    # Annotator sometimes selects the worse answer\n",
        "    pick_i = (gold[i] > gold[j]) ^ (\n",
        "        rng.random(len(i)) < noise\n",
        "    )\n",
        "\n",
        "    winner = np.where(pick_i, i, j)\n",
        "    loser = np.where(pick_i, j, i)\n",
        "\n",
        "    return winner, loser\n",
        "\n",
        "\n",
        "# Test three levels of annotator noise\n",
        "for noise in (0.0, 0.1, 0.3):\n",
        "    winner, loser = annotate(1000, noise)\n",
        "\n",
        "    # Measure agreement with the gold reward\n",
        "    agree = np.mean(gold[winner] > gold[loser])\n",
        "\n",
        "    print(\n",
        "        f\"Noise {noise:.1f}: \"\n",
        "        f\"{len(winner)} pairs, \"\n",
        "        f\"{agree:.3f} agree with the gold reward\"\n",
        "    )\n"
      ]
    }
